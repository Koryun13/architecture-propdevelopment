        <mxCell id="c1" value="Управляет доступом, открывает дверь и шлагбаум,&lt;br&gt;добавляет лицо и номера авто, принимает вызовы&lt;br&gt;[мобильное приложение, HTTPS, OAuth 2.0 + PKCE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="pd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c2" value="Права доступа, команды открытия,&lt;br&gt;регистрация лица по согласию&lt;br&gt;[REST/HTTPS, mTLS, OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd" target="partner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c3" value="События: вызов, проход, въезд&lt;br&gt;[Webhook HTTPS, mTLS, HMAC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="partner" target="pd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="Управление, результаты распознавания&lt;br&gt;[защищённый канал TLS / VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="partner" target="devices"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="Звонит в домофон,&lt;br&gt;подъезжает к шлагбауму" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="guest" target="devices"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="90"/><mxPoint x="1640" y="855"/></Array></mxGeometry></mxCell>
        <mxCell id="c6" value="Проходит по лицу, въезжает по номеру авто" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="devices"><mxGeometry relative="1" x="0.4" as="geometry"><Array as="points"><mxPoint x="1000" y="95"/><mxPoint x="1000" y="892"/></Array></mxGeometry></mxCell>
        <mxCell id="c7" value="Уведомления о вызове и событиях&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd" target="push"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="Видеопоток вызова&lt;br&gt;[WebRTC / SRTP, одноразовый токен]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="partner" target="owner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="260"/><mxPoint x="700" y="260"/><mxPoint x="700" y="47"/></Array></mxGeometry></mxCell>
        <mxCell id="c9" value="Дома, квартиры, собственники&lt;br&gt;[REST/HTTPS через партнёрский шлюз]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uk" target="pd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="Работает с обращениями" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#404040;fontColor=#222222;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dispatcher" target="uk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
