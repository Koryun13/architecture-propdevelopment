<mxfile host="drawio" type="device">
  <diagram name="Безопасность данных" id="data-security-mindmap">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Безопасность данных" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-130" y="-45" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="n3" value="Публичные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="-460" y="-245.5" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;br&gt;• Каталог объектов недвижимости на витрине продаж: описания, планировки, фото, цены&lt;br&gt;• Материалы онлайн-тура (3D-туры, client-tour-app)&lt;br&gt;• Общие новости и объявления УК для жильцов&lt;br&gt;• Информация о компании, ЖК, акциях, публичные тарифы ЖКУ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="-860" y="-285" width="330" height="139" as="geometry"/></mxCell>
        <mxCell id="n6" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-1160" y="-390.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n8" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="Данные изначально опубликованы для всех клиентов, их раскрытие не наносит ущерба компании." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="-390.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n10" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-1160" y="-320.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n12" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="Восстанавливаются из мастер-систем (client-mart-estate-db) и резервных копий; недоступность витрины кратковременно снижает поток заявок." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="-320.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n14" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="-246" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n16" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="Подмена цены или характеристик, дефейс витрины — претензии клиентов по публичной оферте и закону о защите прав потребителей, репутационный ущерб." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="-250.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n18" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="-167" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n20" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="У витрины нет своей БД: данные собираются из client-mart-estate-app и Kafka-каталога. Рассинхронизация приводит к бронированию уже проданных квартир и жалобам." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="-171.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n22" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-1160" y="-92.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n24" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="Устаревший каталог исправляется новой публикацией; самостоятельная ценность публичных данных невысока." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="-92.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n26" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="Внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="-460" y="190" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="n28" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;br&gt;• Регламенты, бизнес-процессы, оргструктура&lt;br&gt;• Учётные записи сотрудников, группы и роли в Active Directory (без паролей)&lt;br&gt;• Архитектурная документация, схемы сети, конфигурации систем&lt;br&gt;• Планы и история текущего и капитального ремонта ЖК&lt;br&gt;• Агрегированная обезличенная аналитика и отчёты BI&lt;br&gt;• Журналы систем и аудита" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="-860" y="128" width="330" height="184" as="geometry"/></mxCell>
        <mxCell id="n30" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="49.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n32" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="Схемы сети, конфигурации и перечень учётных записей облегчают злоумышленнику разведку, фишинг и подбор целей для атаки." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="49.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n34" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="119.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n36" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="Без журналов нельзя расследовать инцидент и пройти аудит; потеря истории ремонтов нарушает обязательства перед собственниками." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="119.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n38" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="189.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n40" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n41" value="Изменённые журналы скрывают следы атаки; неверные графики ремонтов вызывают жалобы собственников." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="189.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n42" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n39" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-1160" y="264" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n44" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n45" value="После смены руководителей нарушена передача информации: документация и реестр учётных записей устаревают, специалист по ИБ видит не все изменения, неактуальные учётки остаются активными." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="259.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n46" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n43" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n47" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-1160" y="338.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n48" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n49" value="Устаревшую аналитику можно пересчитать по данным из DWH; регламенты обновляются плановым процессом." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1690" y="338.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n50" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n51" value="Конфиденциальные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="250" y="-263.5" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="n52" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n2" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n53" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;br&gt;• ПДн клиентов: ФИО, телефон, e-mail, карточка и профиль в client-crm-app&lt;br&gt;• ПДн собственников: ФИО, адрес квартиры, лицевые счета (CRM ЖКУ, tenant-core-db)&lt;br&gt;• История бронирований, осмотров и обращений&lt;br&gt;• Начисления и история оплаты услуг ЖКУ&lt;br&gt;• Бухгалтерский учёт и договоры с контрагентами (accountant-service-1)&lt;br&gt;• Данные, передаваемые партнёрам: УК и поставщикам ЖКУ&lt;br&gt;• Сырые данные в DWH (Greenplum, S3), собранные по CDC" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="-340.5" width="330" height="214" as="geometry"/></mxCell>
        <mxCell id="n54" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n55" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="-408.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n56" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n57" value="ПДн защищает 152-ФЗ: за утечку грозят оборотные штрафы (ст. 13.11 КоАП) и репутационный ущерб, как у конкурента. API партнёров уже отдают ПДн, партнёр одной УК видит данные другой, доступ к DWH не ограничен." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-420.5" width="470" height="76" as="geometry"/></mxCell>
        <mxCell id="n58" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n55" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n59" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="930" y="-326.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n60" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n53" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n61" value="Резервное копирование БД настроено, поэтому данные восстановимы, но простой срывает бронирования, сделки и начисления ЖКУ." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-326.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n62" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n59" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n63" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="-256.5" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n64" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n53" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n65" value="В личном кабинете уже показываются чужие ФИО. Ошибочная связь записей — это раскрытие ПДн третьим лицам, неверные начисления и иски." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-256.5" width="470" height="52" as="geometry"/></mxCell>
        <mxCell id="n66" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n63" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n67" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="-182" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n68" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n53" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n69" value="Несколько несогласованных точек регистрации клиента дают дубли и противоречивые карточки в crm-db и crm-tenant-db. Это корень проблемы с личным кабинетом, и он блокирует продукты на BI, ML и AI." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-186.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n70" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n71" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="930" y="-103" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n72" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n53" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n73" value="Без Data Governance, каталога данных и согласий на цели обработки накопленные в DWH данные нельзя законно использовать для аналитики; по истечении срока хранения ПДн их нужно удалить." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-107.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n74" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n71" target="n73"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n75" value="Секретные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;arcSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="202" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="n76" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n2" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n77" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;br&gt;• Паспортные данные, СНИЛС, ИНН, документы и условия сделки (расширенная форма, client-mart-db)&lt;br&gt;• Обмен с госорганами через СМЭВ (регистрация права собственности)&lt;br&gt;• Платёжные данные и банковские реквизиты&lt;br&gt;• Учётные данные и секреты: пароли, ключи и токены API партнёров, ключи шифрования, Secrets Kubernetes&lt;br&gt;• Команды и коды доступа «Умного дома» (замок квартиры, автоматика)&lt;br&gt;• Биометрия жильцов и номера автомобилей (интеллектуальные домофон и шлагбаум)&lt;br&gt;• Стратегические финансовые данные: себестоимость, неопубликованная отчётность" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="530" y="102.5" width="330" height="259" as="geometry"/></mxCell>
        <mxCell id="n78" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n75" target="n77"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n79" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="48" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n80" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n77" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n81" value="Компрометация ключей и токенов открывает доступ ко всем системам и физический доступ в квартиры. Биометрия относится к особой категории ПДн (ст. 11 152-ФЗ), и её нельзя «перевыпустить»." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="43.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n82" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n79" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n83" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="127" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n84" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n77" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n85" value="Потеря документов сделки срывает регистрацию в госорганах, а потеря ключей шифрования делает зашифрованные данные и резервные копии недоступными." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="122.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n86" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n83" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n87" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="206" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n88" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n77" target="n87"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n89" value="Подмена реквизитов платежа или условий договора — прямые финансовые потери и судебные споры; подмена команд «Умного дома» — незаконное открытие квартиры или шлагбаума." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="201.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n90" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n87" target="n89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n91" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="930" y="285" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n92" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n77" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n93" value="Ошибки в паспортных данных приводят к отказу или задержке регистрации сделки, но выявляются при проверке через СМЭВ до завершения сделки." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="280.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n94" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n91" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n95" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="364" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="n96" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n77" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n97" value="Ценность этих данных — в обеспечении операций, а не в аналитике. Плановая ротация ключей и истечение сроков хранения документов — штатная часть жизненного цикла." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="359.5" width="470" height="61" as="geometry"/></mxCell>
        <mxCell id="n98" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=1;html=1;endArrow=classic;endSize=6;strokeWidth=1.5;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n95" target="n97"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n99" value="&lt;b&gt;Шкала оценки риска&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-170" y="380" width="340" height="24" as="geometry"/></mxCell>
        <mxCell id="n100" value="незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-170" y="408" width="105" height="30" as="geometry"/></mxCell>
        <mxCell id="n101" value="значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-55" y="408" width="105" height="30" as="geometry"/></mxCell>
        <mxCell id="n102" value="критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="408" width="105" height="30" as="geometry"/></mxCell>
        <mxCell id="n103" value="Классификация по ISO/IEC 27001/27002.&lt;br&gt;Уровни: категория → данные → риск и оценка → обоснование" style="text;html=1;align=center;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-190" y="446" width="380" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
